{
  "appId": "com.noahgniffke.bibleincontext",
  "appName": "Bible in Context",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0a0a0a",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0a0a0a",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native",
      "style": "dark"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true
      }
    }
  }
}
